<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Learning Options</title>
    <link rel="stylesheet" href="/css/learning.css">
</head>
<body>

<div class="container">
    <h1>Choose Your Learning Mode</h1>
    <p>Select how you want to continue learning</p>

    <div class="cards">

        <a href="/learn/video" class="card">
            <h2>🎥 Recommend Video</h2>
            <p>Get a video tailored to your topic</p>
        </a>

        <a href="/learn/questions" class="card">
            <h2>❓ Questions</h2>
            <p>Practice with smart adaptive questions</p>
        </a>

        <a href="/learn/explain" class="card">
            <h2>📘 Explain Content</h2>
            <p>Understand the topic step by step</p>
        </a>

    </div>
</div>

</body>
</html>