<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adaptive Tutor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/learning.css">
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="logo">
      <span class="logo-dot"></span>
      <span class="logo-text">adaptive</span><span class="logo-accent">tutor</span>
    </div>
    <div class="topbar-right">
      <a href="/" class="nav-link">Home</a>
      <button class="theme-btn" onclick="toggleTheme()" id="themeBtn">
        <svg id="themeIcon" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <span id="themeLabel">Dark mode</span>
      </button>
    </div>
  </div>
  <div class="hero">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Ollama + BKT + IRT Pipeline
    </div>
    <h1>Teach the lecture to the <span class="gradient">tutor agents</span></h1>
    <p>
      Upload a lecture and the Python backend will extract text, build concepts,
      generate the first question with Ollama, then adapt difficulty with BKT and IRT after every answer.
    </p>
  </div>
  <div id="stateUpload" class="state active">
    <div class="upload-section">
      <div class="drop-area" id="dropArea"
           onclick="document.getElementById('fileInput').click()"
           ondragover="onDragOver(event)"
           ondragleave="onDragLeave(event)"
           ondrop="onDrop(event)">
        <div class="drop-icon-wrap">
          <svg viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <div class="drop-title">Upload a lecture for the adaptive tutor</div>
        <div class="drop-sub">The backend will parse the file, extract concepts, and open the first adaptive question.</div>
        <div class="file-types">
          <%
            const types = typeof acceptedTypes !== 'undefined'
              ? acceptedTypes
              : ['PDF', 'PPT', 'PPTX', 'DOC', 'DOCX', 'TXT'];
          %>
          <% types.forEach(function(t) { %>
            <span class="file-tag"><%= t %></span>
          <% }); %>
        </div>
        <button class="upload-btn"
                onclick="event.stopPropagation(); document.getElementById('fileInput').click()">
          Browse Lecture
        </button>
      </div>
      <input type="file" id="fileInput"
             accept="<%= typeof fileAccept !== 'undefined' ? fileAccept : '.pdf,.ppt,.pptx,.doc,.docx,.txt' %>"
             onchange="onFileSelect(this.files[0])">
      <div class="file-preview-card hidden" id="filePreview">
        <div class="file-icon-box" id="fileIcon">FILE</div>
        <div class="file-info">
          <div class="file-name" id="fileName">-</div>
          <div class="file-meta">
            <span id="fileSize">0 MB</span>
            <span>·</span>
            <span class="file-status">
              <span class="status-dot"></span>Ready for parsing
            </span>
          </div>
        </div>
        <button class="file-remove" onclick="removeFile()" title="Remove file">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="gen-area hidden" id="genArea">
        <button class="gen-btn" id="genBtn" onclick="startProcessing()">
          Start Adaptive Session
        </button>
      </div>
    </div>
  </div>
  <div id="stateProcessing" class="state">
    <div class="processing-state">
      <div class="proc-icon">
        <svg viewBox="0 0 24 24">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <div class="proc-title">Preparing the tutor session</div>
      <div class="proc-sub">Python agents are parsing the lecture and generating the first adaptive question.</div>
      <%
        const procSteps = typeof processingSteps !== 'undefined'
          ? processingSteps
          : [
              'Extracting lecture text...',
              'Building the concept graph...',
              'Initializing BKT and IRT...',
              'Generating the first question with Ollama...'
            ];
      %>
      <div class="proc-steps" id="procSteps">
        <% procSteps.forEach(function(label, idx) { %>
          <div class="proc-step <%= idx === 0 ? 'active' : '' %>" id="procStep<%= idx + 1 %>">
            <div class="step-icon">
              <div class="<%= idx === 0 ? 'spin-ring' : 'pending-dot' %>"></div>
            </div>
            <span><%= label %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  <div id="stateResults" class="state">
    <div class="results-header">
      <div>
        <div class="results-title" id="resultsTitle">Adaptive session ready</div>
        <div class="results-subtitle" id="resultsSubtitle">Answer the current question so the tutor can update BKT and IRT.</div>
      </div>
      <div class="results-actions">
        <button class="act-btn" onclick="refreshSession()">
          <svg viewBox="0 0 24 24">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          Refresh State
        </button>
        <button class="act-btn" onclick="resetApp()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          New Lecture
        </button>
      </div>
    </div>
    <div class="content-grid adaptive-grid">
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">Lecture And Model State</div>
          <div class="panel-tag" id="docBadge">FILE</div>
        </div>
        <div class="lecture-body">
          <div class="doc-card">
            <div class="doc-card-title" id="docTitle">-</div>
            <div class="session-summary" id="sessionSummary">No lecture loaded.</div>
          </div>
          <div class="meta-grid">
            <div class="meta-item">
              <div class="meta-label">Concepts</div>
              <div class="meta-val" id="metaConcepts">-</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Mastered</div>
              <div class="meta-val" id="metaMastered">-</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Answered</div>
              <div class="meta-val" id="metaAnswered">-</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Accuracy</div>
              <div class="meta-val" id="metaAccuracy">-</div>
            </div>
          </div>
          <div class="adaptive-stats">
            <div class="adaptive-stat">
              <span class="adaptive-stat-label">Current concept</span>
              <strong id="currentConceptName">-</strong>
            </div>
            <div class="adaptive-stat">
              <span class="adaptive-stat-label">BKT P(learned)</span>
              <strong id="bktValue">-</strong>
            </div>
            <div class="adaptive-stat">
              <span class="adaptive-stat-label">IRT theta</span>
              <strong id="thetaValue">-</strong>
            </div>
            <div class="adaptive-stat">
              <span class="adaptive-stat-label">Next difficulty b</span>
              <strong id="difficultyValue">-</strong>
            </div>
          </div>
          <div class="section-block">
            <div class="section-title">Concept Graph</div>
            <div class="concept-list" id="conceptList"></div>
          </div>
          <div class="section-block">
            <div class="section-title">Agent Thinking</div>
            <div class="thinking-list" id="thinkingList"></div>
          </div>
        </div>
      </div>
      <div class="questions-panel-wrap">
        <div class="panel-header">
          <div class="panel-title">Current Adaptive Question</div>
          <div class="panel-tag" id="qCountBadge">Question</div>
        </div>
        <div class="adaptive-question-wrap">
          <div class="question-hero">
            <div class="question-pills">
              <span class="q-type-pill short" id="questionConceptPill">Concept</span>
              <span class="q-type-pill mcq" id="questionDifficultyPill">Difficulty</span>
            </div>
            <div class="question-prompt" id="questionPrompt">Upload a lecture to begin.</div>
            <div class="question-context" id="questionContext">The concept summary and expected answer will appear here after setup.</div>
          </div>
          <div class="answer-area">
            <label class="section-title" for="answerInput">Student answer</label>
            <textarea id="answerInput" class="short-textarea" placeholder="Write the student's answer here..."></textarea>
            <div class="answer-actions">
              <div class="answer-timer" id="timerHint">Timer starts when the question is shown.</div>
              <button class="act-btn primary" id="submitAnswerBtn" onclick="submitAnswer()">
                <svg viewBox="0 0 24 24">
                  <path d="M22 2 11 13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
                Submit Answer
              </button>
            </div>
          </div>
          <div class="feedback-panel" id="feedbackPanel">
            <div class="section-title">Tutor response</div>
            <div class="feedback-message" id="feedbackMessage">No answer submitted yet.</div>
            <div class="feedback-block hidden" id="hintBlock"></div>
            <div class="feedback-block hidden" id="explanationBlock"></div>
            <div class="video-list hidden" id="videoList"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="notif hide" id="notif">
  <div class="notif-icon">
    <svg viewBox="0 0 24 24">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
  </div>
  <span id="notifText">Done!</span>
</div>
<script src="/js/learning.js"></script>

<!-- Theme initialization script -->
<script>
    // Default to dark mode for learning page if no preference set
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage))) {
        document.body.classList.add('dark');
        document.getElementById('themeLabel').textContent = 'Light mode';
        const icon = document.getElementById('themeIcon');
        icon.innerHTML = `<circle cx="12" cy="12" r="5"/>
           <line x1="12" y1="1" x2="12" y2="3"/>
           <line x1="12" y1="21" x2="12" y2="23"/>
           <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
           <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
           <line x1="1" y1="12" x2="3" y2="12"/>
           <line x1="21" y1="12" x2="23" y2="12"/>
           <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
           <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>`;
    } else {
        document.body.classList.remove('dark');
        document.getElementById('themeLabel').textContent = 'Dark mode';
        const icon = document.getElementById('themeIcon');
        icon.innerHTML = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`;
    }
</script>
</body>
</html>