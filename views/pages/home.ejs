                <span class="bg-indigo-100/80 text-primary px-3 py-1 rounded-full text-sm font-semibold tracking-wide uppercase mb-4 inline-block shadow-sm">Features</span>
                <h2 class="text-4xl font-bold text-slate-900 mb-6 drop-shadow-sm">Everything you need to <span class="text-gradient">learn smarter</span></h2>
                <p class="text-lg text-slate-600">Powered by intelligent agents that work together to create the optimal learning experience.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-white/80 backdrop-blur-md rounded-2xl p-8 feature-card reveal">
                    <div class="bg-blue-100 w-12 h-12 rounded-xl flex items-center justify-center mb-6 shadow-sm">
