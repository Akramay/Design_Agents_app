            <div class="px-6 pb-6 space-y-4 pt-4 border-t border-slate-200/50">
                <a href="#" class="block text-base font-semibold text-slate-600 hover:text-primary transition-colors">Home</a>
                <a href="#features" class="block text-base font-semibold text-slate-600 hover:text-primary transition-colors">Features</a>
                <a href="#how-it-works" class="block text-base font-semibold text-slate-600 hover:text-primary transition-colors">How It Works</a>
