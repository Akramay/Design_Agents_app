    <!-- How It Works Section -->
    <section id="how-it-works" class="py-24 bg-slate-50/60 backdrop-blur-md border-t border-slate-200/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div class="mb-16 reveal">
                <span class="bg-white text-primary px-4 py-1 rounded-full text-sm font-semibold tracking-wide mb-4 inline-block shadow-sm border border-slate-100">How It Works</span>
                <h2 class="text-4xl font-bold text-slate-900 mb-6">Three steps to <span class="text-gradient">mastery</span></h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">A seamless cycle of analysis, adaptation, and improvement drives your learning forward.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
                
                <!-- Connecting Line (Desktop) -->
                <div class="hidden md:block absolute top-12 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-transparent via-indigo-200 to-transparent z-0"></div>

                <!-- Step 1 -->
                <div class="relative z-10 reveal">
                    <div class="w-24 h-24 mx-auto bg-white rounded-2xl flex items-center justify-center mb-6 relative shadow-md border border-slate-100">
                        <div class="absolute -top-3 -right-3 bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-md">01</div>
                        <i data-lucide="scan-search" class="w-10 h-10 text-primary"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Analyze</h3>
                    <p class="text-slate-600 leading-relaxed">Our AI agents assess your knowledge level by analyzing answers, response time, hint usage, and question difficulty using probabilistic models.</p>
                </div>

                <!-- Step 2 -->
                <div class="relative z-10 reveal" style="transition-delay: 150ms;">
                    <div class="w-24 h-24 mx-auto bg-white rounded-2xl flex items-center justify-center mb-6 relative shadow-md border border-slate-100">
                        <div class="absolute -top-3 -right-3 bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-md">02</div>
                        <i data-lucide="sliders-horizontal" class="w-10 h-10 text-primary"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Adapt</h3>
                    <p class="text-slate-600 leading-relaxed">The system dynamically adjusts your learning path, quiz difficulty, and content recommendations to match your current understanding.</p>
                </div>

                <!-- Step 3 -->
                <div class="relative z-10 reveal" style="transition-delay: 300ms;">
                    <div class="w-24 h-24 mx-auto bg-white rounded-2xl flex items-center justify-center mb-6 relative shadow-md border border-slate-100">
                        <div class="absolute -top-3 -right-3 bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-md">03</div>
                        <i data-lucide="trending-up" class="w-10 h-10 text-primary"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Improve</h3>
                    <p class="text-slate-600 leading-relaxed">Through reinforcement learning, the system continuously optimizes itself — the more you learn, the better it teaches you.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Capabilities Section -->
    <section class="py-24 bg-white/40 backdrop-blur-lg border-y border-slate-200/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                
                <!-- Left Text -->
                <div class="reveal">
                    <span class="bg-teal-50 border border-teal-100 text-teal-600 px-3 py-1 rounded-full text-sm font-semibold tracking-wide mb-6 inline-block shadow-sm">AI Capabilities</span>
                    <h2 class="text-4xl font-bold text-slate-900 mb-6 leading-tight drop-shadow-sm">Powered by a <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-blue-500">Multi-Agent</span> Intelligence System</h2>
                    <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                        Our platform uses multiple specialized AI agents — each responsible for a different aspect of your learning journey. Together, they create an experience that's more effective than any single model could provide.
                    </p>
                    <p class="text-lg text-slate-600 leading-relaxed">
                        From assessing what you know, to choosing what to teach next, to generating feedback and adapting in real-time — every decision is backed by data and refined through reinforcement learning.
                    </p>
                </div>

                <!-- Right Cards Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
