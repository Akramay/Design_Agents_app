    <!-- Mobile Menu Interactivity (Accordion Slide-Down) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const iconMenu = document.getElementById('icon-menu');
            const iconClose = document.getElementById('icon-close');
            const mobileLinks = mobileMenu.querySelectorAll('a');
            let isMenuOpen = false;

            const toggleMenu = () => {
                isMenuOpen = !isMenuOpen;
                if (isMenuOpen) {
                    // Open the accordion by expanding max-height
                    mobileMenu.classList.remove('max-h-0');
                    mobileMenu.classList.add('max-h-[500px]');
                    // Swap icons
                    iconMenu.classList.add('hidden');
                    iconClose.classList.remove('hidden');
                } else {
                    // Close the accordion
                    mobileMenu.classList.remove('max-h-[500px]');
                    mobileMenu.classList.add('max-h-0');
                    // Swap icons back
                    iconMenu.classList.remove('hidden');
                    iconClose.classList.add('hidden');
                }
            };

            // Toggle on hamburger button click
            mobileMenuBtn.addEventListener('click', toggleMenu);

            // Automatically close the menu when a link inside it is clicked
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (isMenuOpen) toggleMenu();
                });
            });
        });
    </script>
